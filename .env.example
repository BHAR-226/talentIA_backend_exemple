# --- Application ---
APP_NAME=TalentIA API
ENVIRONMENT=development
DEBUG=true

# --- Base de données (aligné sur docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://talentia:talentia@localhost:5432/talentia

# --- Sécurité / Auth (JWT en cookie httpOnly) ---
# Générer une vraie clé : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-en-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Nom du cookie de session et options
AUTH_COOKIE_NAME=talentia_session
# En production : COOKIE_SECURE=true (HTTPS obligatoire)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS (frontend Next.js) ---
# Liste séparée par des virgules ; credentials autorisés pour le cookie
CORS_ORIGINS=http://localhost:3000
